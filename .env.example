# 프로젝트 홈 상단 'Connect' 버튼, 또는 Project Settings > Data API 의 Project URL
# (대시보드 주소 supabase.com/dashboard/project/<ref> 의 <ref>로 https://<ref>.supabase.co 직접 만들어도 됨)
SUPABASE_URL=https://xxxx.supabase.co
# Secret key(sb_secret_...) 또는 Legacy 탭의 service_role 키
# 절대 NEXT_PUBLIC_ 붙이지 말 것 (브라우저로 새면 DB 전체 노출)
SUPABASE_SERVICE_ROLE_KEY=

